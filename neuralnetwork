import numpy as np
import matplotlib.pyplot as plt
# ============================================================
# Neural Network Class
# ============================================================
class NeuralNetwork:
 def __init__(self, learning_rate):
 # Initialize weights randomly
 self.weights = np.array([
 np.random.randn(),
 np.random.randn()
 ])
 # Initialize bias randomly
 self.bias = np.random.randn()
 # Set learning rate
 self.learning_rate = learning_rate
 # ========================================================
 # Sigmoid Activation Function
 # ========================================================
 def _sigmoid(self, x):
 return 1 / (1 + np.exp(-x))
 # ========================================================
 # Derivative of Sigmoid
 # ========================================================
 def _sigmoid_deriv(self, x):
 return self._sigmoid(x) * (
 1 - self._sigmoid(x)
 )
 # ========================================================
 # Prediction
 # ========================================================
 def predict(self, input_vector):
 # Weighted sum + bias
 layer_1 = (
 np.dot(input_vector, self.weights)
 + self.bias
 )
 # Apply sigmoid activation
 layer_2 = self._sigmoid(layer_1)
 # Final prediction
 prediction = layer_2
 return prediction
 # ========================================================
 # Compute Gradients using Backpropagation
 # ========================================================
 def _compute_gradients(self, input_vector, target):
 # Forward propagation
 layer_1 = (
 np.dot(input_vector, self.weights)
 + self.bias
 )
 layer_2 = self._sigmoid(layer_1)
 prediction = layer_2
 # Calculate error derivative
 error_prediction = 2 * (
 prediction - target
 )
 # Derivative of sigmoid
 prediction_layer1 = (
 self._sigmoid_deriv(layer_1)
 )
 # Derivative of layer 1 with respect to bias
 dlayer1_dbias = 1
 # Derivative of layer 1 with respect to weights
 dlayer1_dweights = input_vector
 # Gradient of bias
 error_dbias = (
 error_prediction
 * prediction_layer1
 * dlayer1_dbias
 )
 # Gradient of weights
 error_dweights = (
 error_prediction
 * prediction_layer1
 * dlayer1_dweights
 )
 return error_dbias, error_dweights
 # ========================================================
 # Update Parameters
 # ========================================================
 def _update_parameters(
 self,
 error_dbias,
 error_dweights
 ):
 # Update bias
 self.bias = self.bias - (
 error_dbias
 * self.learning_rate
 )
 # Update weights
 self.weights = self.weights - (
 error_dweights
 * self.learning_rate
 )
 # ========================================================
 # Train the Neural Network
 # ========================================================
 def train(
 self,
 input_vectors,
 targets,
 iterations
 ):
 # Store training errors
 cumulative_errors = []
 # Training loop
 for current_iteration in range(iterations):
 # Select a random training example
 random_data_index = np.random.randint(
 len(input_vectors)
 )
 # Get input vector
 input_vector = input_vectors[
 random_data_index
 ]
 # Get target value
 target = targets[
 random_data_index
 ]
 # Calculate gradients
 error_dbias, error_dweights = (
 self._compute_gradients(
 input_vector,
 target
 )
 )
 # Update weights and bias
 self._update_parameters(
 error_dbias,
 error_dweights
 )
 # Calculate cumulative error every 100 iterations
 if current_iteration % 100 == 0:
 cumulative_error = 0
 # Calculate error for every training example
 for data_instance_index in range(
 len(input_vectors)
 ):
 data_point = input_vectors[
 data_instance_index
 ]
 target = targets[
 data_instance_index
 ]
 # Make prediction
 prediction = self.predict(
 data_point
 )
 # Calculate squared error
 error = np.square(
 prediction - target
 )
 # Add error
 cumulative_error += error
 # Store cumulative error
 cumulative_errors.append(
 cumulative_error
 )
 return cumulative_errors
# ============================================================
# DATASET
# ============================================================
input_vectors = np.array([
 [3, 1.5],
 [2, 1],
 [4, 1.5],
 [3, 4],
 [3.5, 0.5],
 [2, 0.5],
 [5.5, 1],
 [1, 1]
])
targets = np.array([
 0,
 1,
 0,
 1,
 0,
 1,
 1,
 0
])
# ============================================================
# CREATE NEURAL NETWORK
# ============================================================
learning_rate = 0.1
neural_network = NeuralNetwork(
 learning_rate
)
# ============================================================
# TRAIN THE NETWORK
# ============================================================
training_error = neural_network.train(
 input_vectors,
 targets,
 10000
)
# ============================================================
# PLOT TRAINING ERROR CURVE
# ============================================================
plt.plot(
 range(0, 10000, 100),
 training_error
)
plt.xlabel("Iterations")
plt.ylabel("Cumulative Error")
plt.title("Training Error Curve")
plt.show()
